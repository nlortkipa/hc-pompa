# Copy to backend/API/.env when running the API with `dotnet run`.
# (docker compose does not use this file; its values are in docker-compose.yml.)

# Required
DATABASE_URL=Host=localhost;Port=5432;Database=pompa;Username=pompa;Password=pompa
JWT_KEY=local-dev-jwt-key-change-me-0123456789abcdef

# Keep local data between restarts (Development wipes the DB on startup otherwise)
RecreateDatabaseOnStartup=false

# Only needed when Sms:SendSms=true (Production)
# SMS_KEY=

# Only needed when Email:SendEmail=true (Production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Pompa
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_ENABLE_SSL=true
